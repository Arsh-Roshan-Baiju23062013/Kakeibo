rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net - deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper function to check if the user is logged in and owns the data
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Dashboard User rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Only the dashboard owner can access or modify their expenses
      match /expenses/{expenseId} {
        allow read, write: if isOwner(userId);
      }

      // Only the dashboard owner can access or modify their earnings
      match /earnings/{earningId} {
        allow read, write: if isOwner(userId);
      }

      // Only the dashboard owner can access or modify their stock portfolio
      match /stocks/{stockId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
